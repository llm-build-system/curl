type = "static-library"
name = "curl"
standards = ["C11"]

[registries]
official = "https://github.com/llm-build-system/llm-registry"

[dependencies]
private = ["official:zlib@1.3.2"]

[defines]
public = ["CURL_STATICLIB"]
private = ["BUILDING_LIBCURL", "HAVE_CONFIG_H", "CURL_HIDDEN_SYMBOLS"]

[windows]
libraries = ["ws2_32", "crypt32", "bcrypt", "normaliz", "iphlpapi", "advapi32", "secur32"]

[windows.includes]
private = ["config/windows"]

[windows.defines]
private = ["NOMINMAX", "_WIN32_WINNT=0x0A00", "_CRT_SECURE_NO_WARNINGS", "_CRT_NONSTDC_NO_DEPRECATE"]

[linux]
libraries = ["pthread", "dl"]

[linux.dependencies]
private = ["official:openssl@3.5.9"]

[linux.includes]
private = ["config/linux"]

[linux.defines]
private = ["_GNU_SOURCE"]

[macos]
libraries = ["pthread", "Security.framework", "CoreFoundation.framework", "SystemConfiguration.framework"]

[macos.dependencies]
private = ["official:openssl@3.5.9"]

[macos.includes]
private = ["config/macos"]

[macos.defines]
private = ["_DARWIN_C_SOURCE", "__STDC_WANT_LIB_EXT1__=1"]
